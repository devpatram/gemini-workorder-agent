# Copy this file to workorder_agent/.env and put your own project ID in it:
#   cp .env.example workorder_agent/.env
# `adk web`, `adk run` and `adk deploy` read the .env inside the agent folder. Never commit it.

# Call Gemini through your Google Cloud project (Gemini Enterprise Agent Platform, formerly Vertex AI).
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
# Older ADK versions read this name instead; both mean the same thing.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# The model and where it is called. scripts/check_model.py finds one that answers and writes it here.
MODEL=gemini-3.5-flash
MODEL_LOCATION=global

# Where the tools read work orders: csv (workorder_agent/data/work_orders.csv) or bigquery.
DATA_SOURCE=csv
# dataset.table, loaded by scripts/load_bigquery.py
BQ_TABLE=workorders.work_orders
